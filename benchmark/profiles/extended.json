{
  "schema_version": 1,
  "defaults": {
    "duration_seconds": 15,
    "objects": 128,
    "analyze_duration": "1s"
  },
  "sizes": [
    { "key": "small", "object_size": "128KiB" },
    { "key": "medium", "object_size": "1MiB" },
    { "key": "large", "object_size": "16MiB" }
  ],
  "concurrency": [
    { "key": "c01", "value": 1 },
    { "key": "c04", "value": 4 },
    { "key": "c16", "value": 16 }
  ],
  "prefix_modes": [
    { "key": "prefix", "noprefix": false },
    { "key": "hot", "noprefix": true }
  ],
  "workloads": [
    {
      "key": "put",
      "command": "put",
      "operation": "PUT",
      "size_keys": ["small", "medium", "large"],
      "concurrency_keys": ["c01", "c04", "c16"],
      "prefix_mode_keys": ["prefix", "hot"],
      "duration_seconds": 10
    },
    {
      "key": "get",
      "command": "get",
      "operation": "GET",
      "size_keys": ["small", "medium", "large"],
      "concurrency_keys": ["c01", "c04", "c16"],
      "prefix_mode_keys": ["prefix", "hot"],
      "duration_seconds": 10,
      "objects": 128
    },
    {
      "key": "get-range",
      "command": "get",
      "operation": "GET",
      "size_keys": ["medium", "large"],
      "concurrency_keys": ["c04", "c16"],
      "prefix_mode_keys": ["prefix"],
      "extra_flags": ["--range"],
      "duration_seconds": 10,
      "objects": 64
    },
    {
      "key": "mixed",
      "command": "mixed",
      "operation": "MIXED",
      "size_keys": ["small", "medium"],
      "concurrency_keys": ["c04", "c16"],
      "prefix_mode_keys": ["prefix", "hot"],
      "duration_seconds": 10,
      "objects": 128
    },
    {
      "key": "list",
      "command": "list",
      "operation": "LIST",
      "size_keys": ["small"],
      "concurrency_keys": ["c04", "c16"],
      "prefix_mode_keys": ["prefix", "hot"],
      "duration_seconds": 10,
      "objects": 128
    },
    {
      "key": "stat",
      "command": "stat",
      "operation": "STAT",
      "size_keys": ["small"],
      "concurrency_keys": ["c04", "c16"],
      "prefix_mode_keys": ["prefix", "hot"],
      "duration_seconds": 10,
      "objects": 128
    },
    {
      "key": "delete",
      "command": "delete",
      "operation": "DELETE",
      "size_keys": ["small"],
      "concurrency_keys": ["c04", "c16"],
      "prefix_mode_keys": ["prefix", "hot"],
      "objects": 1024,
      "duration_seconds": 10
    },
    {
      "key": "multipart-put",
      "command": "multipart-put",
      "operation": "PUT",
      "size_keys": ["large"],
      "concurrency_keys": ["c04", "c16"],
      "prefix_mode_keys": ["prefix"],
      "size_flag": "--part.size",
      "extra_flags": ["--parts=8", "--part.concurrent=2"],
      "duration_seconds": 10
    }
  ]
}
