{
  "schema_version": 1,
  "defaults": {
    "duration_seconds": 30,
    "objects": 512,
    "analyze_duration": "5s"
  },
  "sizes": [
    { "key": "small", "object_size": "128KiB" },
    { "key": "medium", "object_size": "1MiB" },
    { "key": "large", "object_size": "4MiB" },
    { "key": "mpu", "object_size": "8MiB" }
  ],
  "concurrency": [
    { "key": "c01", "value": 1 },
    { "key": "c16", "value": 16 }
  ],
  "prefix_modes": [
    { "key": "prefix", "noprefix": false }
  ],
  "workloads": [
    {
      "key": "put",
      "command": "put",
      "operation": "PUT",
      "size_keys": ["small", "medium", "large"],
      "concurrency_keys": ["c01", "c16"],
      "prefix_mode_keys": ["prefix"]
    },
    {
      "key": "get",
      "command": "get",
      "operation": "GET",
      "size_keys": ["small", "medium", "large"],
      "concurrency_keys": ["c01", "c16"],
      "prefix_mode_keys": ["prefix"],
      "objects": 512
    },
    {
      "key": "get-range",
      "command": "get",
      "operation": "GET",
      "size_keys": ["medium", "large"],
      "concurrency_keys": ["c16"],
      "prefix_mode_keys": ["prefix"],
      "extra_flags": ["--range"],
      "objects": 256
    },
    {
      "key": "list",
      "command": "list",
      "operation": "LIST",
      "size_keys": ["small"],
      "concurrency_keys": ["c16"],
      "prefix_mode_keys": ["prefix"],
      "objects": 1024
    },
    {
      "key": "stat",
      "command": "stat",
      "operation": "STAT",
      "size_keys": ["small"],
      "concurrency_keys": ["c16"],
      "prefix_mode_keys": ["prefix"],
      "objects": 1024
    },
    {
      "key": "multipart-put",
      "command": "multipart-put",
      "operation": "PUT",
      "size_keys": ["mpu"],
      "concurrency_keys": ["c01", "c16"],
      "prefix_mode_keys": ["prefix"],
      "size_flag": "--part.size",
      "extra_flags": ["--parts=8", "--part.concurrent=2"]
    }
  ]
}
